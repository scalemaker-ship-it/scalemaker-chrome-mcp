    "bin",
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "lint": "eslint 'src/**/*.ts'",
    "test": "jest"
  },
  "keywords": [
    "chrome",
    "mcp",
    "playwright",
    "cdp",
    "launcher"
  ],
  "author": "cw02326 (auto-chrome-mcp), scalemaker-ship-it (scalemaker-chrome-mcp)",
  "license": "MIT",
  "repository": {
    "type": "git",
